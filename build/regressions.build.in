CC=@CC@
MAKE=make
CORES=@CORES@
CFLAGS=@CFLAGS@ -I../../../include -DCORES=@CORES@
LD=@LD@
LDFLAGS=@LDFLAGS@
PTHREAD_CFLAGS=@PTHREAD_CFLAGS@
BUILD_DIR=@BUILD_DIR@

# Use within a single check shell initialized with rc=0 and ending in exit $$rc.
CK_CHECK = sh ../../../tools/run-test.sh $(1) || rc=1;

include $(BUILD_DIR)/build/ck.build.@PROFILE@
